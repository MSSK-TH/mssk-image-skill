# 同步/修改时留下的备份
_backup/
*.bak
*.bak-old
*.bak-*

# 编辑器与系统垃圾
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# 本地输出
output/
tmp/

# 密钥文件：只提交 .env.example，真实 .env 永不入库
.env
.env.*
!.env.example
*.pem
shimk_*

# 装的是令牌，只应存在本机
imagegen-relay/config.json

# Python 字节码（跨机无用，且会随版本变动）
__pycache__/
*.pyc
*.pyo

# 会话钥匙（按项目生成，属于本地运行态）
.imagegen/
